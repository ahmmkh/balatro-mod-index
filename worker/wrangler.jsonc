{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bmi-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-14",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Thumbnails are served straight from static assets (free/unlimited, no Worker invocation).
    "run_worker_first": ["/*", "!/thumbnails/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bmi",
      // Replace after `wrangler d1 create bmi`; "local" works for `wrangler dev`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  // Value set with `wrangler secret put IP_SALT`; declared here so types/deploy know it is required.
  "secrets": { "required": ["IP_SALT"] }
}
